{
  "name": "pvlog",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "esbuild",
    "vue-demi"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "backend:server": "cargo run-server",
    "backend:worker": "cargo run-worker",
    "lint": "eslint src/ui && stylelint 'src/ui/**/*.css'",
    "lint:eslint": "eslint src/ui",
    "lint:styles": "stylelint 'src/ui/**/*.css'",
    "openapi:compare": "bun tests/contract/openapi/compare.mjs tests/fixtures/openapi/pvlog-v1.generated.yaml",
    "openapi:analytics": "bun tests/contract/openapi/analytics-examples.mjs",
    "openapi:forecasting": "bun tests/contract/openapi/forecasting.mjs",
    "openapi:lint": "redocly lint --config .redocly.yaml openapi/pvlog-v1.yaml",
    "openapi:routes": "bun tests/contract/openapi/route-coverage.mjs",
    "catalog:validate": "bun scripts/validate-equipment-catalogs.mjs && bun tests/contract/equipment-catalog-format.mjs",
    "catalog:import-open-pv-modules": "bun scripts/import-open-pv-module-database.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:ui:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:smoke": "cargo smoke",
    "test:segment-format": "bun tests/contract/segment-format.mjs",
    "test:local-authentication-guide": "bun tests/contract/local-authentication-guide.mjs",
    "test:structure": "bun test tests/contract/repository-structure/check.test.mjs && bun tests/contract/repository-structure/check.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:bundle-budget": "bun tests/contract/ui-bundle-budget.mjs",
    "test:docs": "bun tests/contract/docs-conformance.mjs",
    "test:release-artifacts": "bun tests/contract/release-artifacts.mjs",
    "test:webhook-consumer": "bun tests/contract/webhook-consumer.mjs",
    "test:query-performance": "bun tests/performance/chart-query-harness.mjs",
    "test:scale-performance": "bun tests/performance/scale-workload-harness.mjs",
    "test:performance-fixtures": "bun tests/performance/fleet-history-generator.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-document-load": "0.66.0",
    "@opentelemetry/instrumentation-fetch": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scalar/api-reference-react": "0.9.63",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "26.4.0",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.33.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-i18next": "17.0.12",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@redocly/cli": "2.46.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "shadcn": "4.18.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
