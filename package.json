{
  "name": "pvlog",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "esbuild",
    "vue-demi"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "backend:server": "cargo run-server",
    "backend:worker": "cargo run-worker",
    "lint": "oxlint src/ui && stylelint 'src/ui/**/*.css'",
    "lint:oxlint": "oxlint src/ui",
    "lint:styles": "stylelint 'src/ui/**/*.css'",
    "openapi:compare": "bun tests/contract/openapi/compare.mjs tests/fixtures/openapi/pvlog-v1.generated.yaml",
    "openapi:analytics": "bun tests/contract/openapi/analytics-examples.mjs",
    "openapi:forecasting": "bun tests/contract/openapi/forecasting.mjs",
    "openapi:lint": "redocly lint --config .redocly.yaml openapi/pvlog-v1.yaml",
    "openapi:routes": "bun tests/contract/openapi/route-coverage.mjs",
    "catalog:validate": "bun scripts/validate-equipment-catalogs.mjs && bun tests/contract/equipment-catalog-format.mjs",
    "catalog:import-open-pv-modules": "bun scripts/import-open-pv-module-database.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:ui:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:smoke": "cargo smoke",
    "test:segment-format": "bun tests/contract/segment-format.mjs",
    "test:local-authentication-guide": "bun tests/contract/local-authentication-guide.mjs",
    "test:structure": "bun test tests/contract/repository-structure/check.test.mjs && bun tests/contract/repository-structure/check.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:bundle-budget": "bun tests/contract/ui-bundle-budget.mjs",
    "test:docs": "bun tests/contract/docs-conformance.mjs",
    "test:release-artifacts": "bun tests/contract/release-artifacts.mjs",
    "test:webhook-consumer": "bun tests/contract/webhook-consumer.mjs",
    "test:query-performance": "bun tests/performance/chart-query-harness.mjs",
    "test:scale-performance": "bun tests/performance/scale-workload-harness.mjs",
    "test:performance-fixtures": "bun tests/performance/fleet-history-generator.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@hookform/resolvers": "7.0.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation": "0.301.1",
    "@opentelemetry/instrumentation-document-load": "0.70.0",
    "@opentelemetry/instrumentation-fetch": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@scalar/api-reference-react": "0.9.89",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "27.1.1",
    "i18next-browser-languagedetector": "8.3.0",
    "lucide-react": "1.72.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "18.0.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@redocly/cli": "2.77.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "31.0.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
